// Graceful shutdown handler
async function shutdown(signal) {
    console.log(`\nReceived ${signal}. Shutting down server and cleaning up...`);
    try {
        // Close the server first to stop accepting new connections
        await new Promise((resolve, reject) => server.close(err => err ? reject(err) : resolve()));
        console.log('Server closed.');

        // Attempt to clean up temporary directories
        console.log('Cleaning up working directories...');
        await fs.promises.rm(APPS_DIR, { recursive: true, force: true });
        await fs.promises.rm(PACKAGED_DIR, { recursive: true, force: true });
        console.log('Cleanup complete.');
        process.exit(0);
    } catch (err) {
        console.error("Error during shutdown cleanup:", err);
        process.exit(1);
    }
}

process.on('SIGINT', () => shutdown('SIGINT'));
process.on('SIGTERM', () => shutdown('SIGTERM'));

// Ensure necessary base directories exist on startup
Promise.all([
    fs.promises.mkdir(APPS_DIR, { recursive: true }),
    fs.promises.mkdir(PACKAGED_DIR, { recursive: true })
