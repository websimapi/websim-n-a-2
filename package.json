const http = require('http');
const fs = require('fs');
const path = require('path');
const archiver = require('archiver');
const { exec } = require('child_process');
const url = require('url'); // To parse URL query parameters if needed later
const { randomBytes } = require('crypto'); // For unique IDs

const PORT = 3000;
const APPS_DIR = path.join(__dirname, 'apps');
const PACKAGED_DIR = path.join(__dirname, 'packaged');

// Helper function to run shell commands
function runCommand(command, options) {
    return new Promise((resolve, reject) => {
        console.log(`Executing: ${command} in ${options.cwd || __dirname}`);
        exec(command, options, (error, stdout, stderr) => {
            if (error) {
                console.error(`Error executing command: ${command}\n${stderr}`);
                return reject(new Error(`Command failed: ${stderr}`));
            }
            console.log(`Command output: ${stdout}`);
            if (stderr) {
                console.warn(`Command stderr: ${stderr}`);
            }
            resolve(stdout);
        });
    });
}

// Helper function for robust cleanup
async function cleanup(appId) {
    const appDir = path.join(APPS_DIR, appId);
    const outputDir = path.join(PACKAGED_DIR, appId);
    const zipPath = path.join(PACKAGED_DIR, `${appId}.zip`);

    console.log(`Cleaning up resources for ${appId}...`);
    try {
        await fs.promises.rm(appDir, { recursive: true, force: true });
        console.log(`Removed ${appDir}`);
    } catch (err) {
        console.warn(`Warning: Could not remove ${appDir}: ${err.message}`);
    }
    try {
        await fs.promises.rm(outputDir, { recursive: true, force: true });
        console.log(`Removed ${outputDir}`);
    } catch (err) {
        console.warn(`Warning: Could not remove ${outputDir}: ${err.message}`);
    }
    try {
        // Check if zip file exists before attempting deletion
        if (fs.existsSync(zipPath)) {
            await fs.promises.unlink(zipPath);
            console.log(`Removed ${zipPath}`);
        }
    } catch (err) {
        console.warn(`Warning: Could not remove ${zipPath}: ${err.message}`);
    }
}


